{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-calendar.local/schemas/desktop-updater-evidence.schema.json",
  "title": "Agent Calendar controlled Desktop updater and rollback evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha",
    "tag",
    "previousVersion",
    "candidateVersion",
    "candidateSha256",
    "controlledFeed",
    "sha512Verified",
    "update",
    "rollback",
    "cleanup",
    "screenshots"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "previousVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "candidateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "controlledFeed": { "const": true },
    "sha512Verified": { "const": true },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedVersion",
        "offeredVersion",
        "installedVersion",
        "signedCandidateVerified",
        "userDataPreserved"
      ],
      "properties": {
        "startedVersion": { "type": "string" },
        "offeredVersion": { "type": "string" },
        "installedVersion": { "type": "string" },
        "signedCandidateVerified": { "const": true },
        "userDataPreserved": { "const": true }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manualOnly",
        "automaticDowngradeAttempted",
        "retainedPreviousArtifactVerified",
        "rollbackRehearsed",
        "restoredVersion"
      ],
      "properties": {
        "manualOnly": { "const": true },
        "automaticDowngradeAttempted": { "const": false },
        "retainedPreviousArtifactVerified": { "const": true },
        "rollbackRehearsed": { "const": true },
        "restoredVersion": { "type": "string" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qaApplicationRemoved", "qaUserDataRemoved"],
      "properties": {
        "qaApplicationRemoved": { "const": true },
        "qaUserDataRemoved": { "const": true }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
