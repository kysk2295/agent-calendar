{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-calendar.invalid/schemas/private-beta-stability.schema.json",
  "title": "Agent Calendar private-beta stability evidence",
  "description": "Redaction-safe manifest and chained receipt envelope. Semantic window and reset rules are enforced by the repository evaluator.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "productionAuthorityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "algorithm",
        "keyId",
        "issuedAt",
        "expiresAt",
        "manifestDigest",
        "receiptChainRoot",
        "candidateBindingDigest",
        "cohortDigest",
        "operatorDigest",
        "windowStateDigest",
        "evaluatorSchema",
        "sourceId",
        "sourceSha",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "const": "private-beta-production-2026-01"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "receiptChainRoot": {
          "$ref": "#/$defs/digest"
        },
        "candidateBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "cohortDigest": {
          "$ref": "#/$defs/digest"
        },
        "operatorDigest": {
          "$ref": "#/$defs/digest"
        },
        "windowStateDigest": {
          "$ref": "#/$defs/digest"
        },
        "evaluatorSchema": {
          "const": "private-beta-stability/v1"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceSha": {
          "$ref": "#/$defs/sourceSha"
        },
        "signature": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evaluatorSchema",
        "authorityMode",
        "cohortDigest",
        "operatorDigest",
        "candidateSetId",
        "sourceId",
        "sourceSha",
        "timezone",
        "windowStart",
        "windowEnd",
        "p0p1AuthorityDigest",
        "resetPolicy",
        "generatedAt",
        "productionAuthorityEnvelope"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evaluatorSchema": {
          "const": "private-beta-stability/v1"
        },
        "authorityMode": {
          "enum": [
            "external_signed_release",
            "local_contract_only"
          ]
        },
        "cohortDigest": {
          "$ref": "#/$defs/digest"
        },
        "operatorDigest": {
          "$ref": "#/$defs/digest"
        },
        "candidateSetId": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceSha": {
          "$ref": "#/$defs/sourceSha"
        },
        "timezone": {
          "const": "UTC"
        },
        "windowStart": {
          "$ref": "#/$defs/timestamp"
        },
        "windowEnd": {
          "$ref": "#/$defs/timestamp"
        },
        "p0p1AuthorityDigest": {
          "$ref": "#/$defs/digest"
        },
        "resetPolicy": {
          "const": "p0_p1_or_qualifying_rollback"
        },
        "generatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "productionAuthorityEnvelope": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/productionAuthorityEnvelope"
            }
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evaluatorSchema",
        "receiptId",
        "kind",
        "observedAt",
        "cohortDigest",
        "operatorDigest",
        "candidateSetId",
        "sourceId",
        "sourceSha",
        "payload",
        "sequence",
        "previousDigest",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evaluatorSchema": {
          "const": "private-beta-stability/v1"
        },
        "receiptId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "candidate_install",
            "daily_evidence",
            "weekly_review",
            "incident",
            "rollback"
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "cohortDigest": {
          "$ref": "#/$defs/digest"
        },
        "operatorDigest": {
          "$ref": "#/$defs/digest"
        },
        "candidateSetId": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceSha": {
          "$ref": "#/$defs/sourceSha"
        },
        "payload": {
          "type": "object"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previousDigest": {
          "$ref": "#/$defs/digest"
        },
        "receiptDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
