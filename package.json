{
  "name": "agent-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "description": "Agent Calendar monorepo for the Electron desktop app, macOS widgets, and the backend they use.",
  "workspaces": [
    "apps/desktop",
    "apps/backend",
    "apps/runner"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "electron:dev": "npm --workspace apps/desktop run electron:dev",
    "build:desktop": "npm --workspace apps/desktop run build",
    "build:electron": "npm --workspace apps/desktop run build:electron",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test": "npm --workspace apps/backend run test && npm --workspace apps/desktop run test && npm --workspace apps/runner run test",
    "test:backend": "npm --workspace apps/backend run test",
    "test:backend:critical": "node --test apps/backend/tests/phase1-workspace-isolation.test.cjs apps/backend/tests/phase1-backend-security-boundary.test.cjs apps/backend/tests/workos-authkit-adapter.test.cjs apps/backend/tests/phase1-workos-desktop-login.test.cjs",
    "test:production-auth-mode-cutover": "node --test apps/backend/tests/production-auth-mode-cutover.test.cjs",
    "test:production-readiness": "node --test scripts/production-readiness.test.cjs",
    "test:runner": "npm --workspace apps/runner run test",
    "runner:check": "npm --workspace apps/runner run check",
    "setup:workos": "bash scripts/setup-workos-env.sh",
    "backend:start": "npm --workspace apps/backend run start",
    "backend:start:workos": "bash scripts/start-workos-backend.sh",
    "backend:check": "npm --workspace apps/backend run check",
    "backend:migrate": "npm --workspace apps/backend run db:migrate",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web test",
    "test:widget-contract": "node --test apps/desktop/tests/macos-widget-contract.test.mjs",
    "build:widget:unsigned": "set -eu; derived_data_dir=\"$(mktemp -d \"${TMPDIR:-/tmp}/agent-calendar-widget-derived-data.XXXXXX\")\"; cleanup() { rm -rf \"$derived_data_dir\"; }; trap cleanup EXIT; xcodebuild clean build -project apps/widget/macos/HermesWidgetHost/HermesWidgetHost.xcodeproj -scheme HermesWidgetHost -configuration Release -derivedDataPath \"$derived_data_dir\" CODE_SIGNING_ALLOWED=NO; cleanup; trap - EXIT; test ! -e \"$derived_data_dir\"",
    "test:desktop-release-smoke": "npm --workspace apps/desktop run test:release-smoke",
    "verify:multi-user-ete": "AGENT_CALENDAR_E2E_TWO_ACCOUNT=1 node apps/desktop/tests/playwright-phase3-golden-ete.cjs",
    "verify:production-workspace-isolation": "WORKSPACE_AUTH_MODE=production node --test apps/backend/tests/phase1-full-gateway-workspace-cutover.test.cjs",
    "verify:first-user-journey:injected": "AGENT_CALENDAR_E2E_TIMEOUT_MS=120000 node apps/desktop/tests/playwright-first-user-journey.cjs",
    "verify:production-readiness": "scripts/production-readiness.sh",
    "verify:staging-clean-account": "node scripts/staging-workos-clean-account.cjs live-preflight",
    "verify:beta": "npm run backend:check && npm run typecheck && npm test && npm run build:desktop"
  }
}
