{
  "name": "agent-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Calendar monorepo for the Electron desktop app, macOS widgets, and the backend they use.",
  "workspaces": [
    "apps/desktop",
    "apps/backend"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "electron:dev": "npm --workspace apps/desktop run electron:dev",
    "build:desktop": "npm --workspace apps/desktop run build",
    "build:electron": "npm --workspace apps/desktop run build:electron",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test": "npm --workspace apps/backend run test && npm --workspace apps/desktop run test",
    "test:backend": "npm --workspace apps/backend run test",
    "backend:start": "npm --workspace apps/backend run start",
    "backend:check": "npm --workspace apps/backend run check",
    "backend:migrate": "npm --workspace apps/backend run db:migrate"
  }
}
